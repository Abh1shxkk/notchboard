{
  "manifest_version": 3,
  "name": "Dashing New Tab",
  "version": "3.0.0",
  "description": "A personal command center new tab built from the sites you actually use.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["topSites", "history", "storage", "favicon", "search", "sessions", "tabs", "alarms", "notifications"],
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon.png" }
}
